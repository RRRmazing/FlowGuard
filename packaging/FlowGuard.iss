; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only.

#define MyAppName "FlowGuard"
#define MyAppVersion "0.1.0"
#define MyAppPublisher "xfx & hjj"
#define MyAppURL "https://github.com/RRRmazing/FlowGuard"
#define MyAppExeName "FlowGuard.exe"
#define DoubleAmp(Value) StringChange(Value, "&", "&&")
#define EscapeConstArgument(Value) StringChange(StringChange(StringChange(Value, "%", "%25"), ",", "%2c"), "}", "%7d")

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{80AE614D-ECCC-470C-8E2F-D4F39BA9B9D7}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={cm:NameAndVersion,{#EscapeConstArgument(MyAppName)},{#EscapeConstArgument(MyAppVersion)}}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={localappdata}\Programs\{#MyAppName}
DisableDirPage=no
UninstallDisplayIcon={app}\{#MyAppExeName}
; "ArchitecturesAllowed=x64compatible" specifies that Setup cannot run on anything but x64 and Windows 11 on Arm.
ArchitecturesAllowed=x64compatible
; "ArchitecturesInstallIn64BitMode=x64compatible" requests that the install be done in "64-bit mode" on x64 or Windows 11 on Arm.
; This means it should use the native 64-bit Program Files directory and the 64-bit view of the registry.
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0.17763
LicenseFile=..\LICENSE
InfoBeforeFile=install-notes.txt
; Uncomment the following line to use a 64-bit installer.
;SetupArchitecture=x64
DisableProgramGroupPage=yes
; Remove the following line to run in administrative install mode (install for all users).
PrivilegesRequired=lowest
OutputDir=..\build\installer
OutputBaseFilename=FlowGuard-{#MyAppVersion}-windows-x64-Setup
SetupIconFile=..\assets\flowguard.ico
SolidCompression=yes
WizardStyle=modern dynamic

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "chinesesimplified"; MessagesFile: "compiler:Languages\ChineseSimplified.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "..\build\deploy\windows-x64\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "..\build\prerequisites\vc_redist.x64.exe"; Flags: dontcopy
Source: "{tmp}\FlowGuard-storage.ini"; DestDir: "{localappdata}\FlowGuard"; DestName: "storage.ini"; Flags: external onlyifdoesntexist uninsneveruninstall skipifsourcedoesntexist

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#DoubleAmp(MyAppName)}}"; Flags: nowait postinstall skipifsilent

[CustomMessages]
english.StorageTitle=Data storage locations
english.StorageDescription=Choose where captured packets and logs are saved.
english.StorageHint=These locations are separate from the application installation folder.
english.CaptureFolder=Captured packet folder:
english.LogFolder=Log folder:
english.StorageDirError=Cannot create the directory. Choose a writable absolute path:
english.StorageWriteError=Cannot prepare storage settings. Installation has not started.
english.NpcapMissing=Install Npcap from https://npcap.com/ and run this installer again. Npcap is not bundled.
english.RuntimeFailed=The Microsoft Visual C++ runtime could not be installed. Install vc_redist.x64.exe from Microsoft and try again.

chinesesimplified.StorageTitle=数据保存位置
chinesesimplified.StorageDescription=请选择报文和日志的保存目录。
chinesesimplified.StorageHint=数据保存位置与程序安装位置分开设置。
chinesesimplified.CaptureFolder=报文保存目录：
chinesesimplified.LogFolder=日志保存目录：
chinesesimplified.StorageDirError=无法创建目录，请选择可写的绝对路径：
chinesesimplified.StorageWriteError=无法准备保存位置配置，安装尚未开始。
chinesesimplified.NpcapMissing=请先从 https://npcap.com/ 安装 Npcap，再运行本安装程序。安装包不捆绑 Npcap。
chinesesimplified.RuntimeFailed=无法安装微软 Visual C++ 运行库，请从微软官网安装 vc_redist.x64.exe 后重试。

[Code]
var
  StoragePage: TInputDirWizardPage;

procedure InitializeWizard;
begin
  StoragePage := CreateInputDirPage(
    wpSelectDir,
    CustomMessage('StorageTitle'),
    CustomMessage('StorageDescription'),
    CustomMessage('StorageHint'),
    False, '');

  StoragePage.Add(CustomMessage('CaptureFolder'));
  StoragePage.Add(CustomMessage('LogFolder'));

  StoragePage.Values[0] :=
    ExpandConstant('{userdocs}\FlowGuard\Captures');
  StoragePage.Values[1] :=
    ExpandConstant('{userdocs}\FlowGuard\Logs');
end;

function StorageConfigFile: String;
begin
  Result := ExpandConstant('{localappdata}\FlowGuard\storage.ini');
end;

function ShouldSkipPage(PageID: Integer): Boolean;
begin
  Result := False;
  if PageID = StoragePage.ID then
    Result := FileExists(StorageConfigFile);
end;

function QtIniPath(Value: String): String;
begin
  StringChangeEx(Value, '\', '/', True);
  Result := '"' + Value + '"';
end;

function RuntimeInstalled: Boolean;
var
  Major, Minor, Build: Cardinal;
begin
  Result := False;
  if RegQueryDWordValue(HKLM64, 'SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64', 'Major', Major) and
     RegQueryDWordValue(HKLM64, 'SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64', 'Minor', Minor) and
     RegQueryDWordValue(HKLM64, 'SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64', 'Bld', Build) then
    Result := (Major > 14) or ((Major = 14) and ((Minor > 51) or ((Minor = 51) and (Build >= 36231))));
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  I, ExitCode: Integer;
  Directory: String;
  Lines: TArrayOfString;
begin
  Result := '';
  if not FileExists(ExpandConstant('{sys}\Npcap\wpcap.dll')) then
  begin
    Result := CustomMessage('NpcapMissing');
    Exit;
  end;

  if not RuntimeInstalled then
  begin
    ExtractTemporaryFile('vc_redist.x64.exe');
    if not ShellExec('runas', ExpandConstant('{tmp}\vc_redist.x64.exe'),
      '/install /passive /norestart', '', SW_SHOWNORMAL,
      ewWaitUntilTerminated, ExitCode) then
    begin
      Result := CustomMessage('RuntimeFailed');
      Exit;
    end;
    if (ExitCode <> 0) and (ExitCode <> 3010) and (ExitCode <> 1638) then
    begin
      Result := CustomMessage('RuntimeFailed');
      Exit;
    end;
    if ExitCode = 3010 then NeedsRestart := True;
    if not RuntimeInstalled then
    begin
      Result := CustomMessage('RuntimeFailed');
      Exit;
    end;
  end;

  if FileExists(StorageConfigFile) then Exit;
  { Values are selected on the page; do not overwrite existing configurations. }
  for I := 0 to 1 do
  begin
    Directory := Trim(StoragePage.Values[I]);
    if (Directory = '') or
       ((Copy(Directory, 2, 2) <> ':\') and (Copy(Directory, 1, 2) <> '\\')) then
    begin
      Result := CustomMessage('StorageDirError') + #13#10 + Directory;
      Exit;
    end;
    if not ForceDirectories(Directory) then
    begin
      Result := CustomMessage('StorageDirError') + #13#10 + Directory;
      Exit;
    end;
    StoragePage.Values[I] := Directory;
  end;
  SetArrayLength(Lines, 6);
  Lines[0] := '[General]';
  Lines[1] := 'captureDirectory=' + QtIniPath(StoragePage.Values[0]);
  Lines[2] := 'logRoot=' + QtIniPath(StoragePage.Values[1]);
  Lines[3] := '';
  Lines[4] := '[storage]';
  Lines[5] := 'confirmed=true';
  if not SaveStringsToUTF8File(ExpandConstant('{tmp}\FlowGuard-storage.ini'), Lines, False) then
    Result := CustomMessage('StorageWriteError');
end;
