{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FlowGuard: Build",
      "type": "shell",
      "command": ".\\scripts\\build.cmd",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "FlowGuard: Run",
      "type": "shell",
      "command": ".\\scripts\\run.cmd",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "FlowGuard: Check",
      "type": "shell",
      "command": ".\\scripts\\test.cmd",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
